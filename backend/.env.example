# Copiar este archivo a backend/.env y reemplazar los valores.
# backend/.env NUNCA se sube al repositorio.

POSTGRES_DB=pulsepass
POSTGRES_USER=pulsepass
POSTGRES_PASSWORD=cambiar-esta-clave

# Clave HMAC del JWT: Base64 de al menos 32 bytes aleatorios.
# Generar con:  openssl rand -base64 32
# La aplicación debe fallar al arrancar si esta variable falta o es débil.
PULSEPASS_JWT_SECRET_BASE64=
